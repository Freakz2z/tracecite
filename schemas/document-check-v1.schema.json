{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TraceCite document check report v1",
  "type": "object",
  "required": [
    "schema_version",
    "tool_version",
    "document_count",
    "checked_count",
    "failed_count",
    "warning_count",
    "skipped_count",
    "unbound_snippets",
    "online",
    "items",
    "review"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "tool_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "document_count": {
      "type": "integer",
      "minimum": 0
    },
    "checked_count": {
      "type": "integer",
      "minimum": 0
    },
    "failed_count": {
      "type": "integer",
      "minimum": 0
    },
    "warning_count": {
      "type": "integer",
      "minimum": 0
    },
    "skipped_count": {
      "type": "integer",
      "minimum": 0
    },
    "unbound_snippets": {
      "type": "integer",
      "minimum": 0
    },
    "online": {
      "type": "boolean"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "review": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "locations"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "locations": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/item"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "baseline_preview": {
      "$ref": "#/$defs/preview"
    },
    "skipped_quotes": {
      "type": "integer",
      "minimum": 0,
      "description": "Unassociated complete quotations explicitly skipped; absent before 0.8.0."
    },
    "unassociated_quotes": {
      "type": "string",
      "enum": [
        "review",
        "skip"
      ],
      "description": "Effective quote policy; absent before 0.8.0."
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "document",
        "line",
        "source",
        "kind",
        "status",
        "code",
        "message",
        "category"
      ],
      "properties": {
        "document": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "expected": {
          "type": "string"
        },
        "actual": {
          "type": "string"
        },
        "previous": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "change_analysis": {
          "$ref": "#/$defs/source_diff"
        }
      },
      "additionalProperties": true
    },
    "snapshot_entry": {
      "type": "object",
      "required": [
        "document",
        "source",
        "kind",
        "observed"
      ],
      "properties": {
        "document": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "observed": {
          "type": "string"
        },
        "excerpt": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "snapshot_change": {
      "type": "object",
      "required": [
        "document",
        "source",
        "kind",
        "change"
      ],
      "properties": {
        "document": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "change": {
          "type": "string"
        },
        "excerpt": {
          "type": "string"
        },
        "previous": {
          "type": "string"
        },
        "current": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "snapshot": {
      "type": "object",
      "required": [
        "version",
        "entries"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/snapshot_entry"
          }
        }
      },
      "additionalProperties": true
    },
    "preview": {
      "type": "object",
      "required": [
        "can_update",
        "added_count",
        "changed_count",
        "removed_count",
        "changes",
        "scanned_documents"
      ],
      "properties": {
        "can_update": {
          "type": "boolean"
        },
        "added_count": {
          "type": "integer",
          "minimum": 0
        },
        "changed_count": {
          "type": "integer",
          "minimum": 0
        },
        "removed_count": {
          "type": "integer",
          "minimum": 0
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/snapshot_change"
          }
        },
        "scanned_documents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "snapshot": {
          "$ref": "#/$defs/snapshot"
        }
      },
      "additionalProperties": true
    },
    "source_diff_hunk": {
      "type": "object",
      "required": [
        "previous_start_line",
        "previous_line_count",
        "current_start_line",
        "current_line_count",
        "previous_text",
        "current_text",
        "text_truncated"
      ],
      "properties": {
        "previous_start_line": {
          "type": "integer",
          "minimum": 1
        },
        "previous_line_count": {
          "type": "integer",
          "minimum": 0
        },
        "current_start_line": {
          "type": "integer",
          "minimum": 1
        },
        "current_line_count": {
          "type": "integer",
          "minimum": 0
        },
        "previous_text": {
          "type": "string",
          "maxLength": 514
        },
        "current_text": {
          "type": "string",
          "maxLength": 514
        },
        "text_truncated": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "source_diff": {
      "type": "object",
      "required": [
        "algorithm",
        "coordinate_system",
        "complete",
        "hunks",
        "display_truncated"
      ],
      "properties": {
        "algorithm": {
          "const": "bounded_lcs_lines_v1"
        },
        "coordinate_system": {
          "const": "observed_source_1_based"
        },
        "complete": {
          "type": "boolean"
        },
        "reason": {
          "enum": [
            "input_limit",
            "line_limit",
            "cell_limit"
          ]
        },
        "previous_line_count": {
          "type": "integer",
          "minimum": 0
        },
        "current_line_count": {
          "type": "integer",
          "minimum": 0
        },
        "added_lines": {
          "type": "integer",
          "minimum": 0
        },
        "removed_lines": {
          "type": "integer",
          "minimum": 0
        },
        "total_hunks": {
          "type": "integer",
          "minimum": 0
        },
        "hunks": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/source_diff_hunk"
          }
        },
        "display_truncated": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "complete": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "previous_line_count",
              "current_line_count",
              "added_lines",
              "removed_lines",
              "total_hunks"
            ]
          },
          "else": {
            "required": [
              "reason"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "added_lines"
                  ]
                },
                {
                  "required": [
                    "removed_lines"
                  ]
                },
                {
                  "required": [
                    "total_hunks"
                  ]
                }
              ]
            }
          }
        }
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
